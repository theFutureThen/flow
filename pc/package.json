{
  "name": "flow-pc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @flow/desktop",
    "make": "npm run make -w @flow/desktop",
    "package": "npm run package -w @flow/desktop",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "stylelint": "^17.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
